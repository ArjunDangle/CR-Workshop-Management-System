# pyenv
#   For a library or package, you might want to consider not ignoring
#   .python-version, since it ensures users have a consistent version.
.python-version

# pipenv
# According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
# Pipfile.lock

# poetry
# Poetry automatically creates virtual environments in `~/.cache/pystack/virtualenvs`,
# e.g. /home/user/.cache/pystack/virtualenvs/project_name-F0fKx-py3.10
# so the `venv` or `.venv` rule is not needed here. However, it may be desirable to
# configure poetry to create virtual environments `.venv` in the project root instead
# (e.g. `poetry config virtualenvs.in-project true`).
# See https://python-poetry.org/docs/configuration/#virtualenvsin-project
# poetry.lock

# pdm
# Similar to Pipfile.lock, it is recommended to include pdm.lock in version control.
# pdm.lock
# The `.pdm-python` or `.pdm-build` folders are created when you issue the `pdm build` command.
# These folders are necessary for the build process.
.pdm-build/
.pdm-python/

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/

